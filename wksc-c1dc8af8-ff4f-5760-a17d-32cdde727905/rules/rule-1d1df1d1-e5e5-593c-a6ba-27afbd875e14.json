        "procedure" : "DECLARE\r\n    TYPE Dpt_rec IS RECORD (\r\n        DNO   NUMBER(4,0),\r\n        DNAME VARCHAR2(30)\r\n    );\r\n    TYPE Dpt_TAB IS TABLE OF Dpt_rec;\r\n    dpt_ouput Dpt_TAB := Dpt_TAB();\r\nBEGIN\r\n    SELECT DEPARTMENT_ID, DEPARTMENT_NAME\r\n    BULK COLLECT INTO dpt_ouput\r\n    FROM HR.DEPARTMENTS;\r\n\r\n    FOR i IN 1 .. dpt_ouput.COUNT LOOP\r\n        DBMS_OUTPUT.PUT_LINE(dpt_ouput(i).DNO || ',' || dpt_ouput(i).DNAME);\r\n    END LOOP;\r\nEND;",

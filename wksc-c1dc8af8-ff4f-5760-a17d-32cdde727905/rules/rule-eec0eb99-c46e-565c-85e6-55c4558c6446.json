      "input" : "Sql",
      "configuration" : {
        "sql" : "SELECT \n    c.CustomerID, \n    a.AddressLine1, \n    a.AddressLine2, \n    a.City, \n    sp.Name AS StateProvince, \n    a.PostalCode, \n    cr.Name AS CountryRegion\nFROM \n    AdventureWorks.Sales.Customer c\nJOIN \n    AdventureWorks.Person.BusinessEntityAddress bea ON c.PersonID = bea.BusinessEntityID\nJOIN \n    AdventureWorks.Person.Address a ON bea.AddressID = a.AddressID\nJOIN \n    AdventureWorks.Person.AddressType at ON bea.AddressTypeID = at.AddressTypeID\nJOIN \n    AdventureWorks.Person.StateProvince sp ON a.StateProvinceID = sp.StateProvinceID\nJOIN \n    AdventureWorks.Person.CountryRegion cr ON sp.CountryRegionCode = cr.CountryRegionCode\nWHERE \n    at.Name = 'Home'",
        "appendOrderBy" : true,
        "isDeferredSort" : false,

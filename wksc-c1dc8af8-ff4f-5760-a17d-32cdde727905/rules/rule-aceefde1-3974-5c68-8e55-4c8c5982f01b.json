        } ],
        "procedure" : "DECLARE \r\n\r\n    TYPE Dpt_rec IS RECORD ( \r\n\r\n        SID   VARCHAR2(2000), \r\n\r\n        JC VARCHAR2(2000), \r\n\r\n        SAL Number (22), \r\n\r\n        BN NUMBER (20,6), \r\n\r\n        BD DATE, \r\n\r\n        HD TIMESTAMP \r\n\r\n         \r\n\r\n    ); \r\n\r\n    TYPE Dpt_TAB IS TABLE OF Dpt_rec; \r\n\r\n    dpt_ouput Dpt_TAB := Dpt_TAB(); \r\n\r\nBEGIN \r\n\r\n    SELECT STAFFID, JOBCODE, SALARY, BONUS, BIRTHD, HIRED \r\n\r\n    BULK COLLECT INTO dpt_ouput \r\n\r\n    FROM REGRESSION_DATABASE.STAFF; \r\n\r\nDBMS_OUTPUT.PUT_LINE('STAFFID, JOBCODE, SALARY, BONUS, BIRTHD, HIRED'); \r\n\r\n    FOR i IN 1 .. dpt_ouput.COUNT LOOP \r\n\r\n        DBMS_OUTPUT.PUT_LINE(dpt_ouput(i).SID || ',' || dpt_ouput(i).JC || ',' || dpt_ouput(i).SAL || ',' || dpt_ouput(i).BN || ',' || dpt_ouput(i).BD || ',' || dpt_ouput(i).HD); \r\n\r\n    END LOOP; \r\n\r\nEND;",

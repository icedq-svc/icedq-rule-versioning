  "version" : 1,
  "info" : {
    "ruleType" : "Validation",
    "properties" : {
      "criticality" : "Warning",
      "engineType" : "HighThroughput",
      "stopAtFailAndErrorCount" : 0,
      "stopAtRowCount" : 0,
      "stopAtTime" : 0,
      "degreeOfParallelism" : 1,
      "engineInfo" : { },
      "languageType" : "groovy"
    },
    "objects" : [ {
      "id" : "SourceDataset",
      "type" : "source",
      "name" : "sourceDataset",
      "connectionType" : "Database",
      "connectionId" : "conn-602be8b0-f9a6-58b8-b34d-c58223e9176c",
      "input" : "Sql",
      "configuration" : {
        "sql" : "SELECT \n    c.CustomerID AS customer_id,\n    c.Gender AS gender,\n    c.FirstName AS first_name,\n    c.LastName AS last_name,\n    c.BirthDate AS birth_date,\n    c.DateFirstPurchase AS date_first_purchase,\n    c.PhoneNo AS phone_number,\n    c.YearlyIncome AS yearly_income,\n    c.Email AS email,\n    ca.City AS city,\n    ca.AddressID AS address_id,\n    ca.Country AS country\nFROM \n    regression_database.dbo.Customer c\nJOIN \n    regression_database.dbo.CustomerAddress ca \nON \n    c.CustomerID = ca.CustomerID",
        "appendOrderBy" : true,
        "isDeferredSort" : false,
        "columns" : [ {
          "index" : 1,
          "name" : "customer_id",
          "datatype" : "INT",
          "icedqDatatype" : "INT"
        }, {
          "index" : 2,
          "name" : "gender",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        }, {
          "index" : 3,
          "name" : "first_name",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        }, {
          "index" : 4,
          "name" : "last_name",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        }, {
          "index" : 5,
          "name" : "birth_date",
          "datatype" : "DATE",
          "icedqDatatype" : "DATE"
        }, {
          "index" : 6,
          "name" : "date_first_purchase",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        }, {
          "index" : 7,
          "name" : "phone_number",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        }, {
          "index" : 8,
          "name" : "yearly_income",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        }, {
          "index" : 9,
          "name" : "email",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        }, {
          "index" : 10,
          "name" : "city",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        }, {
          "index" : 11,
          "name" : "address_id",
          "datatype" : "INT",
          "icedqDatatype" : "INT"
        }, {
          "index" : 12,
          "name" : "country",
          "datatype" : "VARCHAR",
          "icedqDatatype" : "TEXT"
        } ]
      }
    }, {
      "id" : "RecordCheck",
      "type" : "recordCheck",
      "name" : "checks",
      "configuration" : {
        "checks" : [ {
          "name" : "resulttype",
          "index" : 1,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "caseInsensitive" : false,
            "values" : [ "Xp" ]
          },
          "id" : "chck-e3dfd371-1fcd-507a-9284-d0693451f23d",
          "type" : "ResultType"
        }, {
          "name" : "Chk_0001",
          "index" : 2,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[first_name] != null && S.[last_name] != null && !(S.[first_name] + ' ' + S.[last_name] in new HashSet(S.collect { it.first_name + ' ' + it.last_name }))",
            "caseInsensitive" : false
          },
          "id" : "chck-aa68401a-7cf7-50e8-95db-c81b6eb223ab",
          "type" : "Custom",
          "description" : "Ensure combination of First Name + Last Name is not duplicated."
        }, {
          "name" : "Chk_0002",
          "index" : 3,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[Gender] == \"M\" || S.[Gender] == \"F\"",
            "caseInsensitive" : false
          },
          "id" : "chck-0ca56f60-678e-554c-9901-d9cd0f51b8ab",
          "type" : "Custom",
          "description" : "Ensure Gender value is either \"M\" or \"F\""
        }, {
          "name" : "Chk_0003",
          "index" : 4,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[Gender] == \"M\" && S.[FirstName].endsWith(\"a\")",
            "caseInsensitive" : false
          },
          "id" : "chck-59db592d-835b-529f-8b1e-e85420cc156d",
          "type" : "Custom",
          "description" : "Ensure if Gender is \"M\" and First Name ends with \"a\""
        }, {
          "name" : "Chk_0004",
          "index" : 5,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[BirthDate] != null && S.[BirthDate] <= new Date() && S.[BirthDate] >= new java.text.SimpleDateFormat(\"yyyy-MM-dd\").parse(\"1900-01-01\")",
            "caseInsensitive" : false
          },
          "id" : "chck-eb5f8644-b2d6-5fca-827c-d6680db4f85b",
          "type" : "Custom",
          "description" : "Ensure Birth Date is not in the future or before 1900."
        }, {
          "name" : "Chk_0005",
          "index" : 6,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[phone_number] != null && S.[phone_number].replaceAll(\"\\\\D\", \"\").length() == 10",
            "caseInsensitive" : false
          },
          "id" : "chck-3a49f85f-deab-5aa4-b250-f1aea867edd3",
          "type" : "Custom",
          "description" : "Ensure Phone Number has correct number of digits."
        }, {
          "name" : "Chk_0006",
          "index" : 7,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[phone_number] != null && S.[phone_number] =~ /^[2-9].*/",
            "caseInsensitive" : false
          },
          "id" : "chck-816b3b2e-b55c-5b49-9c4f-fe451b48ac23",
          "type" : "Custom",
          "description" : "Ensure Phone Number starts with a valid digit (not 0 or 1)."
        }, {
          "name" : "Chk_0007",
          "index" : 8,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[email] ==~ /\\w+([\\.-]?\\w+)*@\\w+([\\.-]?\\w+)*(\\.\\w{2,3})+/",
            "caseInsensitive" : false
          },
          "id" : "chck-2eccf11f-b67f-54fb-86b3-a08f2e0c1a28",
          "type" : "Custom",
          "description" : "Ensure Email follows proper email format (e.g., name@domain.com)."
        }, {
          "name" : "Chk_0008",
          "index" : 9,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[email] ==~ /@adventure-works\\.com$/",
            "caseInsensitive" : false
          },
          "id" : "chck-06854a66-89c8-50b3-b834-6f64b8f83669",
          "type" : "Custom",
          "description" : "Ensure Email domain belongs to \"adventure-works.com\"."
        }, {
          "name" : "Chk_0009",
          "index" : 10,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[yearly_income] > '100000' ? (S.[phone_number] != null && S.[phone_number].trim() && S.[email] ==~ /\\w+([\\.-]?\\w+)*@\\w+([\\.-]?\\w+)*(\\.\\w{2,3})+/) : true",
            "caseInsensitive" : false
          },
          "id" : "chck-837f8414-292d-52d0-82c5-e4dbe1bdbd69",
          "type" : "Custom",
          "description" : "Ensure if Yearly Income > 100,000, then customer must have a valid Phone Number and Email."
        }, {
          "name" : "Chk_0010",
          "index" : 11,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[AddressID] > 0",
            "caseInsensitive" : false
          },
          "id" : "chck-b6adffb8-e1f2-507f-bf9b-5b5c3f495634",
          "type" : "Custom",
          "description" : "Ensure Address ID is a positive number."
        }, {
          "name" : "Chk_0011",
          "index" : 12,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[AddressID] != null && S.[CustomerID] != null && (S.[AddressID] in S.collect { it.[AddressID] }.unique())",
            "caseInsensitive" : false
          },
          "id" : "chck-443a31bf-5cd6-590f-85e0-579023356658",
          "type" : "Custom",
          "description" : "Ensure each Address ID is linked to only one Customer ID (no duplicates)."
        }, {
          "name" : "Chk_0012",
          "index" : 13,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[country] == 'US' && S.[first_name] != null && S.[last_name] != null",
            "caseInsensitive" : false
          },
          "id" : "chck-bfd6e31f-c7e5-5960-a691-f5723d54b545",
          "type" : "Custom",
          "description" : "Ensure firstname and lastname is from US country"
        } ]
      }
    }, {
      "id" : "Report",
      "type" : "report",
      "name" : "exceptionReport",

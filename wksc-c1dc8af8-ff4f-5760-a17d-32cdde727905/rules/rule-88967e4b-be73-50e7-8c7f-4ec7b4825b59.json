          "icedqDatatype" : "TEXT"
        } ],
        "procedure" : "DECLARE @id INT, @name VARCHAR(100);\r\n\r\n  DECLARE @Results TABLE (\r\n\t  customerid INT,\r\n\t  firstname VARCHAR(100)\r\n  );\r\n\r\n  DECLARE emp_cursor CURSOR FOR\r\n  SELECT customerid, firstname FROM customer;\r\n\r\n  OPEN emp_cursor;\r\n\r\n  FETCH NEXT FROM emp_cursor INTO @id, @name;\r\n\r\n  WHILE @@FETCH_STATUS = 0\r\n  BEGIN\r\n\r\n\t  INSERT INTO @Results (customerid, firstname)\r\n\t  VALUES (@id, @name);\r\n\r\n\t  FETCH NEXT FROM emp_cursor INTO @id, @name;\r\n  END\r\n\r\n  CLOSE emp_cursor;\r\n  DEALLOCATE emp_cursor;\r\n\r\n  SELECT * FROM @Results;"
      },

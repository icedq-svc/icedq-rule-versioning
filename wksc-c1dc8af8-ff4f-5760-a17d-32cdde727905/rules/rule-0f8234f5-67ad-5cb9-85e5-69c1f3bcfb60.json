      "connectionId" : "conn-f741cc9d-a9d9-5312-8a11-efc634e96f09",
      "input" : "Sql",
      "configuration" : {
        "sql" : "select id,info,\r\n         trim(unnest(xpath('//p:ID/text()', info::xml, ARRAY[ARRAY['p','DAF.Part']]))::text) AS part_id,\r\n         unnest(xpath('//p:Owner/text()', info::xml, ARRAY[ARRAY['p','DAF.Part']]))::text AS owner,\r\n         unnest(xpath('//p:Origin/text()', info::xml, ARRAY[ARRAY['p','DAF.Part']]))::text AS origin,\r\n         unnest(xpath('//p:Description/text()', info::xml, ARRAY[ARRAY['p','DAF.Part']]))::text AS description,\r\n         unnest(xpath('//*[local-name()=\"EmissionRelated\"]/text()', info::xml))::text AS EmissionRelated,\r\n         unnest(xpath('//*[local-name()=\"isSaleable\"]/text()', info::xml))::text AS isSaleable,\r\n         unnest(xpath('//*[local-name()=\"isAvailable\"]/text()', info::xml))::text AS isAvailable,\r\n         unnest(xpath('//*[local-name()=\"isEcoFriendly\"]/text()', info::xml))::text AS isEcoFriendly,\r\n         unnest(xpath('//*[local-name()=\"CatalogPageIndicator\"]/text()', info::xml))::text AS CatalogPageIndicator,\r\n         unnest(xpath('//*[local-name()=\"ProductMainGroup\"]/@ID', info::xml))::text AS ProductMainGroup,\r\n         unnest(xpath('//*[local-name()=\"ProductSubGroup\"]/@ID', info::xml))::text AS ProductSubGroup,\r\n         unnest(xpath('//vmrs:VMRSSystem/text()', info::xml, ARRAY[ARRAY['vmrs','DAF.AfterSales.VMRS']]))::text AS VMRSSystem,\r\n         unnest(xpath('//vmrs:VMRSAssembly/text()', info::xml, ARRAY[ARRAY['vmrs','DAF.AfterSales.VMRS']]))::text AS VMRSAssembly,\r\n         unnest(xpath('//vmrs:VMRSComponent/text()', info::xml, ARRAY[ARRAY['vmrs','DAF.AfterSales.VMRS']]))::text AS VMRSComponent,\r\n         unnest(xpath('//p:ID/text()', info::xml, ARRAY[ARRAY['p','DAF.Part']]))::text AS superseded_part_id,\r\n         unnest(xpath('//p:Owner/text()', info::xml, ARRAY[ARRAY['p','DAF.Part']]))::text AS superseded_owner,\r\n         unnest(xpath('//p:Origin/text()', info::xml, ARRAY[ARRAY['p','DAF.Part']]))::text AS superseded_origin,\r\n         unnest(xpath('//*[local-name()=\"Quantity\"]/text()', info::xml))::text AS superseded_quantity,\r\n         unnest(xpath('//*[local-name()=\"ChangeType\"]/text()', info::xml))::text AS ChangeType,\r\n         unnest(xpath('//*[local-name()=\"ChangeDateTime\"]/text()', info::xml))::text AS ChangeDateTime\r\n        FROM public.parts_changes_xml_data\r\n        order by 3",
        "appendOrderBy" : true,
        "isDeferredSort" : false,

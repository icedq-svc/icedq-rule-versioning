        "sql" : "SELECT \n    c.CustomerID,\n    a.AddressLine1,\n    a.AddressLine2,\n    a.City,\n    a.StateProvinceID,\n    a.PostalCode\nFROM \n    AdventureWorks.Sales.Customer c\nJOIN \n    AdventureWorks.Person.BusinessEntityAddress bea ON c.PersonID = bea.BusinessEntityID\nJOIN \n    AdventureWorks.Person.Address a ON bea.AddressID = a.AddressID\nJOIN \n    AdventureWorks.Person.AddressType at ON bea.AddressTypeID = at.AddressTypeID\nWHERE \n    at.Name = 'Home'",

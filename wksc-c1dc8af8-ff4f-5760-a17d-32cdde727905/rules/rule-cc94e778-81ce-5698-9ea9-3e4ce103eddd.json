      }
    }, {
      "id" : "RecordCheck",
      "type" : "recordCheck",
      "name" : "checks",
      "configuration" : {
        "checks" : [ {
          "name" : "resulttype",
          "index" : 1,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "caseInsensitive" : false,
            "values" : [ "a-b", "b-a", "Xp" ]
          },
          "id" : "chck-0ebbf353-bc0f-51b1-b69a-20df62872d41",
          "type" : "ResultType"
        }, {
          "name" : "Chk_0002",
          "index" : 2,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[CHANGETYPE] in ['INSERTED', 'UPDATED']",
            "caseInsensitive" : false
          },
          "id" : "chck-a035974e-4e4c-55d2-ac1b-abc439a8c291",
          "type" : "Custom",
          "description" : "Change Type must be either INSERTED or UPDATED."
        }, {
          "name" : "Chk_0003",
          "index" : 3,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[PRODUCTNAME].startsWith('Widget')",
            "caseInsensitive" : false
          },
          "id" : "chck-4eb9bceb-fa65-58bb-8673-e869fa8e6bc3",
          "type" : "Custom",
          "description" : "Product Name should start with \"Widget\""
        }, {
          "name" : "Chk_0004",
          "index" : 4,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[PAYMENTSTATUS] == 'Completed' ? S.[TOTALDUE] > 0 : true",
            "caseInsensitive" : false
          },
          "id" : "chck-24260555-cc4e-567d-aec3-5320c417b77b",
          "type" : "Custom",
          "description" : "If PaymentStatus = Completed, then Total Due must be > 0."
        }, {
          "name" : "Chk_0005",
          "index" : 5,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[CITY] == 'New York' && S.[PHONE].startsWith('(212)')",
            "caseInsensitive" : false
          },
          "id" : "chck-35f03905-9401-54de-9ab9-5e3b8761f13a",
          "type" : "Custom",
          "description" : "Ensure employees in New York have phone numbers starting with (212).\n"
        }, {
          "name" : "Chk_0006",
          "index" : 6,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[ORDERSTATUS] == 'Delivered' ? S.[PAYMENTSTATUS] == 'Completed' : true",
            "caseInsensitive" : false
          },
          "id" : "chck-07ba714a-7aef-5ed8-b031-18cd56be996a",
          "type" : "Custom",
          "description" : "If Order Status is Delivered, Payment Status must be Completed."
        } ]
      }

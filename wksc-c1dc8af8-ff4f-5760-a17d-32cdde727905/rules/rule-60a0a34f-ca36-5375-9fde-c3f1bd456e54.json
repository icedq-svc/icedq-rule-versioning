          "datatype" : "varchar",
          "icedqDatatype" : "TEXT"
        } ],
        "procedure" : "DECLARE @id INT, @name VARCHAR(100); \r\n  DECLARE @Results TABLE ( \r\n  customerid INT, \r\n  firstname VARCHAR(100) \r\n  ); \r\n  DECLARE emp_cursor CURSOR FOR \r\n  SELECT customerid, firstname FROM customer; \r\n  OPEN emp_cursor; \r\n  FETCH NEXT FROM emp_cursor INTO @id, @name; \r\n  WHILE @@FETCH_STATUS = 0 \r\n  BEGIN \r\n  INSERT INTO @Results (customerid, firstname) \r\n  VALUES (@id, @name); \r\nFETCH NEXT FROM emp_cursor INTO @id, @name; \r\n  END \r\n  CLOSE emp_cursor; \r\n  DEALLOCATE emp_cursor; \r\n  SELECT * FROM @Results;"
      },

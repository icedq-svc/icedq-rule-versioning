        }, {
          "name" : "Chk_0001",
          "index" : 2,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[HISTORYID] != null",
            "caseInsensitive" : false
          },
          "id" : "chck-c4efb2d2-48db-52bc-95ae-210470353502",
          "type" : "Custom",
          "description" : "Ensure History ID is not null.\n"
        }, {
          "name" : "Chk_0002",
          "index" : 3,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[PRODUCTID] != null && S.[PRODUCTID].trim()",
            "caseInsensitive" : false
          },
          "id" : "chck-acea8f20-b718-56df-8ef1-88a7e04e3a0d",
          "type" : "Custom",
          "description" : "Product ID must be available.\n"
        }, {
          "name" : "Chk_0003",
          "index" : 4,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[PAYMENTSTATUS] != null",
            "caseInsensitive" : false
          },
          "id" : "chck-486272c1-68c6-588b-9996-04bb481f0399",
          "type" : "Custom",
          "description" : "Payment Status should not be null.\n"
        }, {
          "name" : "Chk_0004",
          "index" : 5,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[EMAIL] != null && S.[EMAIL].contains('@')",
            "caseInsensitive" : false
          },
          "id" : "chck-36895760-3ba0-5f99-b5d6-bf6a72d54803",
          "type" : "Custom",
          "description" : "Validate Email contains @.\n\n"
        }, {
          "name" : "Chk_0005",
          "index" : 6,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[ORDERDATE] != null && new java.text.SimpleDateFormat(\"yyyy-MM-dd\").parse(S.[ORDERDATE]).compareTo(new Date()) <= 0",
            "caseInsensitive" : false
          },
          "id" : "chck-5a20364f-c144-5fd1-bb16-ae73fde54efc",
          "type" : "Custom",
          "description" : "Order Date should not be in the future.\n"
        }, {
          "name" : "Chk_0006",
          "index" : 7,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[PAYMENTTYPE] in ['Credit Card', 'PayPal', 'Bank Transfer']",
            "caseInsensitive" : false
          },
          "id" : "chck-88180182-c748-511e-ada4-54a372c72db9",
          "type" : "Custom",
          "description" : "Payment Type should be one of: Credit Card, PayPal, Bank Transfer.\n"
        }, {
          "name" : "Chk_0007",
          "index" : 8,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[TOTALDUE] > 0 && S.[TOTALDUE] == T.[TOTALDUE]",
            "caseInsensitive" : false
          },
          "id" : "chck-a4468785-3fab-5ca6-9657-e7031b67ec56",
          "type" : "Custom",
          "description" : "For Delivered orders, Total Due must be > 0 and match calculation.\n"
        }, {
          "name" : "Chk_0009",
          "index" : 9,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "S.[PRODUCTTYPE] == \"Type A\" ? S.[UNITPRICE] > 50 : true",
            "caseInsensitive" : false
          },
          "id" : "chck-5da06947-162b-5e29-8bb2-1af596da1180",
          "type" : "Custom",
          "description" : "If Product Type is \"Type A\", Unit Price must be > 50.\n"
        } ]

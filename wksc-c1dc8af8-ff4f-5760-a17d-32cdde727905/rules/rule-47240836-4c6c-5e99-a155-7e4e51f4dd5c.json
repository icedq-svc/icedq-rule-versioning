        "procedure" : "DECLARE @id NVARCHAR(2000), @sex CHAR(1), @Jobc NVARCHAR(2000), @sal FLOAT(8), @bon INT, @birt DATETIME;  \r\n  DECLARE @Results TABLE (  \r\n  STAFFID NVARCHAR(2000),  \r\n  SEX CHAR(1), \r\n  JOBCODE  NVARCHAR(2000), \r\n  SALARY FLOAT(8), \r\n  BONUS INT, \r\n  BIRTHD DATETIME \r\n  );  \r\n  DECLARE emp_cursor CURSOR FOR  \r\n  SELECT STAFFID, SEX, JOBCODE, SALARY, BONUS, BIRTHD FROM staff;  \r\n  OPEN emp_cursor;  \r\n  FETCH NEXT FROM emp_cursor INTO @id, @sex, @Jobc, @sal, @bon, @birt;  \r\n  WHILE @@FETCH_STATUS = 0  \r\n  BEGIN  \r\n  INSERT INTO @Results (STAFFID, SEX, JOBCODE, SALARY, BONUS, BIRTHD)  \r\n  VALUES (@id, @sex, @Jobc, @sal, @bon, @birt);  \r\nFETCH NEXT FROM emp_cursor INTO @id, @sex, @Jobc, @sal, @bon, @birt;  \r\n  END  \r\n  CLOSE emp_cursor;  \r\n  DEALLOCATE emp_cursor;  \r\n  SELECT * FROM @Results; "

          "name" : "Create_dttm",
          "index" : 3,
          "isActive" : true,
          "isVisible" : true,
          "expression" : {
            "value" : "def trimSeconds(timestamp) {\n\n    def date = new Date().parse(\"yyyy-MM-dd HH:mm:ss\", timestamp)\n\n    def trimmedDate = new Date(date.time - (date.time % 60000)) // Trims seconds by rounding down to the nearest minute\n\n    return trimmedDate\n\n}\n \ndef compareTimestamps(source, target) {\n\n    def sourceTimestamp = trimSeconds(S.[create_dttm])\n\n    def targetTimestamp = trimSeconds(T.[create_dttm] )\n\n    return S.[create_dttm] .compareTo(T.[create_dttm] )\n\n}",
            "caseInsensitive" : false
          },
          "id" : "chck-4021e060-0238-589d-810e-6d495d6e221b",
          "type" : "Custom",
          "customFields" : [ {
            "field" : "data_quality_dimension",

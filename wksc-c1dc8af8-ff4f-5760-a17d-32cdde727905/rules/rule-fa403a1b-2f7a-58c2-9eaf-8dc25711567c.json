          "icedqDatatype" : "TEXT"
        } ],
        "procedure" : "DECLARE @id INT, @name VARCHAR(100); \r\n\r\n  DECLARE @Results TABLE ( \r\n\r\n  customerid INT, \r\n\r\n  firstname VARCHAR(100) \r\n\r\n  ); \r\n\r\n  DECLARE emp_cursor CURSOR FOR \r\n\r\n  SELECT customerid, firstname FROM customer; \r\n\r\n  OPEN emp_cursor; \r\n\r\n  FETCH NEXT FROM emp_cursor INTO @id, @name; \r\n\r\n  WHILE @@FETCH_STATUS = 0 \r\n\r\n  BEGIN \r\n\r\n  INSERT INTO @Results (customerid, firstname) \r\n\r\n  VALUES (@id, @name); \r\n\r\nFETCH NEXT FROM emp_cursor INTO @id, @name; \r\n\r\n  END \r\n\r\n  CLOSE emp_cursor; \r\n\r\n  DEALLOCATE emp_cursor; \r\n\r\n  SELECT * FROM @Results; "

        "procedure" : "DECLARE \r\n\r\n    TYPE Dpt_rec IS RECORD ( \r\n\r\n        DNO   NUMBER(4,0), \r\n\r\n        DNAME VARCHAR2(30) \r\n\r\n    ); \r\n\r\n    TYPE Dpt_TAB IS TABLE OF Dpt_rec; \r\n\r\n    dpt_ouput Dpt_TAB := Dpt_TAB(); \r\n\r\nBEGIN \r\n\r\n    SELECT DEPARTMENT_ID, DEPARTMENT_NAME \r\n\r\n    BULK COLLECT INTO dpt_ouput \r\n\r\n    FROM HR.DEPARTMENTS; \r\n\r\nDBMS_OUTPUT.PUT_LINE('DEPARTMENT_ID, DEPARTMENT_NAME'); \r\n\r\n    FOR i IN 1 .. dpt_ouput.COUNT LOOP \r\n\r\n        DBMS_OUTPUT.PUT_LINE(dpt_ouput(i).DNO || ',' || dpt_ouput(i).DNAME); \r\n\r\n    END LOOP; \r\n\r\nEND; ",
